# 本地连 VPS 上的库（需 SSH 隧道）示例：
# ssh -i /path/to/key -L 5433:127.0.0.1:5433 root@VPS_IP
# DATABASE_URL=postgresql+psycopg://geo:geo@127.0.0.1:5433/geo
#
# 在 VPS 本机上 API 使用：
DATABASE_URL=postgresql+psycopg://geo:geo@127.0.0.1:5433/geo
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo
POSTGRES_DB=geo
API_HOST=0.0.0.0
API_PORT=8200

# 鉴权（公网部署必填；留空 = 完全不校验，仅限本机开发）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# /v1/* 用请求头 X-API-Key；/qa 页面用 /qa/login 登录后写 HttpOnly Cookie
API_KEY=
# 上了 HTTPS 反代后置 true，让 QA Cookie 只走加密通道
API_COOKIE_SECURE=false

# B5 crawl
CRAWL_MODE=fake
FAKE_WORKER_ENABLED=true
DEEPSEEK_STORAGE_STATE=
PLAYWRIGHT_HEADLESS=true
