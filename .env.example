# 本地连 VPS 上的库（需 SSH 隧道）示例：
# ssh -i /path/to/key -L 5433:127.0.0.1:5433 root@VPS_IP
# DATABASE_URL=postgresql+psycopg://geo:geo@127.0.0.1:5433/geo
#
# 在 VPS 本机上 API 使用：
DATABASE_URL=postgresql+psycopg://geo:geo@127.0.0.1:5433/geo
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo
POSTGRES_DB=geo
API_HOST=0.0.0.0
API_PORT=8200

# 鉴权（公网部署必填；留空 = 完全不校验，仅限本机开发）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# /v1/* 用请求头 X-API-Key；/qa 页面用 /qa/login 登录后写 HttpOnly Cookie
API_KEY=
# 上了 HTTPS 反代后置 true，让 Cookie 只走加密通道（生产是 true）
API_COOKIE_SECURE=false

# ── 部署拓扑：前端与 API **同源**（一个域名按路径分流）──
# 生产：https://geo.example.com，Caddy 把 /v1 /qa /health 转 8200，其余转前端进程。
# 同源就不需要 CORS，Cookie 也不必放宽 SameSite。
#
# ⚠️ Caddy 站点必须同时收 http:// 与 https://（`http://x, https://x { ... }`）：
#    Cloudflare 是 Flexible 模式、回源走 HTTP:80，只写 https 的话 Caddy 会自动
#    308 到 HTTPS，CF 原样返给浏览器 —— 无限重定向且请求到不了应用。
#
# 留空 = 不启用 CORS。真要把前端拆到另一个域名时才逐个列出（带 Cookie 不允许 "*"）。
# 那样做的代价见 BACKEND.md §5.4：曾经拆过，又合了回来。
CORS_ALLOW_ORIGINS=
# 同源用 lax。只有跨站部署才需要 none，而 none 时浏览器强制要求 Secure=true。
API_COOKIE_SAMESITE=lax
#
# 放宽 SameSite **不引入 CSRF** —— Cookie 只对 GET/HEAD/OPTIONS 有效，
# 跨站构造不出被认证的写操作（有测试逐方法守着）。

# ── D2 用户体系 ──
# CSRF 双提交校验。**默认 false**：前端未适配前开了会让所有会话写操作 403。
# 前端在真浏览器里验过「读 geo_csrf Cookie 回填 X-CSRF-Token」之后再置 true。
# 只影响会话身份的写操作；X-API-Key 的机器调用不受影响。
# 生产已置 true（2026-08-11）。这里保持 false 是给「还没适配的新环境」用的默认值。
CSRF_PROTECTION_ENABLED=false

# B5 crawl
CRAWL_MODE=fake
FAKE_WORKER_ENABLED=true
DEEPSEEK_STORAGE_STATE=
PLAYWRIGHT_HEADLESS=true
