FROM mcr.microsoft.com/playwright/python:v1.49.1-jammy

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # browsers already in this image
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY packages/metrics /app/packages/metrics
COPY apps/api /app/apps/api
# 部署后检查（L2 浏览器冒烟）跑在这个容器里 —— Playwright 与三个浏览器内核
# 本来就为抓取装好了，冒烟复用它们，不必再起一套环境。
COPY scripts /app/scripts

RUN pip install --upgrade pip setuptools wheel \
    && pip install -e /app/packages/metrics \
    && pip install -e /app/apps/api \
    && pip install "playwright==1.49.1" "Pillow>=10"

WORKDIR /app/apps/api
CMD ["python", "-m", "app.worker_main"]
